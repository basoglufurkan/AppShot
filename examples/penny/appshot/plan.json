{
  "$schema": "appshot/plan@1",
  "app": {
    "name": "Penny",
    "icon": "raw/icon.png",
    "subtitle": {
      "en-US": "Budget & Bill Tracker"
    }
  },
  "niche": "budget-expense",
  "theme": "mint",
  "themeOverrides": {
    "accent": "#039855"
  },
  "brand": {
    "primary": "#12B76A",
    "secondary": "#6172F3"
  },
  "panorama": false,
  "sizes": [
    "iphone-6.9",
    "iphone-6.3",
    "android-phone"
  ],
  "locales": [
    "en-US"
  ],
  "defaultLocale": "en-US",
  "keywords": {
    "en-US": [
      "budget",
      "expense tracker",
      "money",
      "bills",
      "spending"
    ]
  },
  "storeOverrides": {
    "android": {
      "theme": {
        "device": {
          "frame": "flat"
        }
      }
    }
  },
  "shots": [
    {
      "id": "hook",
      "layout": "billboard",
      "screen": "raw/home.png",
      "headline": {
        "en-US": "See where your **money goes**"
      },
      "subhead": {
        "en-US": "in one calm view"
      },
      "alternatives": {
        "en-US": [
          "Your **budget**, finally clear"
        ]
      },
      "pop": {
        "rect": [
          0.046,
          0.209,
          0.908,
          0.219
        ]
      }
    },
    {
      "id": "left",
      "layout": "zoom-callout",
      "screen": "raw/home.png",
      "headline": {
        "en-US": "Know what's **left to spend**"
      },
      "subhead": {
        "en-US": "Updated with every expense you add"
      },
      "zoom": {
        "rect": [
          0.03,
          0.06,
          0.94,
          0.13
        ],
        "side": "right"
      }
    },
    {
      "id": "track",
      "layout": "floating-cards",
      "screen": "raw/budgets.png",
      "headline": {
        "en-US": "Stay **on track** every month"
      },
      "cards": [
        {
          "icon": "✅",
          "value": {
            "en-US": "On track"
          },
          "title": {
            "en-US": "May budget"
          },
          "pos": "tr"
        },
        {
          "icon": "🛒",
          "value": "81%",
          "title": {
            "en-US": "Groceries used"
          },
          "pos": "ml"
        }
      ]
    },
    {
      "id": "bills",
      "layout": "notification-stack",
      "screen": "raw/home.png",
      "headline": {
        "en-US": "Never miss a **bill** again"
      },
      "notifications": [
        {
          "title": {
            "en-US": "Electricity bill due in 2 days"
          },
          "body": {
            "en-US": "Tap to mark it as paid"
          },
          "time": "9:41"
        },
        {
          "title": {
            "en-US": "Eating out is over budget"
          },
          "body": {
            "en-US": "Want to move money from Shopping?"
          },
          "time": {
            "en-US": "now"
          }
        }
      ]
    },
    {
      "id": "private",
      "layout": "feature-list",
      "screen": "raw/budgets.png",
      "headline": {
        "en-US": "Private by **design**"
      },
      "bullets": {
        "en-US": [
          "Locked with Face ID",
          "Works fully offline",
          "Balance widget on your Home Screen"
        ]
      },
      "storeOverrides": {
        "android": {
          "bullets": {
            "en-US": [
              "Biometric lock",
              "Works fully offline",
              "Balance widget on your home screen"
            ]
          }
        }
      }
    },
    {
      "id": "close",
      "layout": "text-hero",
      "headline": {
        "en-US": "Spend **without guilt**"
      },
      "chips": [
        {
          "text": {
            "en-US": "Monthly budgets"
          },
          "icon": "📊"
        },
        {
          "text": {
            "en-US": "Bill reminders"
          },
          "icon": "🔔"
        },
        {
          "text": {
            "en-US": "Face ID lock"
          },
          "icon": "🔒"
        }
      ],
      "storeOverrides": {
        "android": {
          "chips": [
            {
              "text": {
                "en-US": "Monthly budgets"
              },
              "icon": "📊"
            },
            {
              "text": {
                "en-US": "Bill reminders"
              },
              "icon": "🔔"
            },
            {
              "text": {
                "en-US": "Biometric lock"
              },
              "icon": "🔒"
            }
          ]
        }
      }
    }
  ],
  "creative": {
    "screens": [
      "raw/home.png",
      "raw/budgets.png"
    ],
    "headline": {
      "en-US": "See where your **money goes**"
    },
    "video": true
  }
}
