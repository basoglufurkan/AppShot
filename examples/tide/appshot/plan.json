{
  "$schema": "appshot/plan@1",
  "app": {
    "name": "Tide",
    "icon": "raw/icon.png",
    "subtitle": {
      "en-US": "Water Tracker & Reminders"
    }
  },
  "niche": "water-tracker",
  "theme": "sky",
  "brand": {
    "primary": "#1E7BF0",
    "secondary": "#22C3E6"
  },
  "panorama": false,
  "sizes": [
    "iphone-6.9",
    "android-phone"
  ],
  "locales": [
    "en-US"
  ],
  "defaultLocale": "en-US",
  "keywords": {
    "en-US": [
      "water tracker",
      "drink water",
      "water reminder",
      "hydration",
      "water intake",
      "water goal"
    ]
  },
  "storeOverrides": {
    "android": {
      "theme": {
        "device": {
          "frame": "flat"
        }
      }
    }
  },
  "shots": [
    {
      "id": "hook",
      "layout": "billboard",
      "screen": "raw/today.png",
      "theme": {
        "bg": {
          "type": "radial",
          "at": "75% 50%",
          "colors": [
            "#1F5FC8",
            "#0C3480",
            "#06173D"
          ]
        },
        "text": "#FFFFFF",
        "subtext": "rgba(255,255,255,.85)",
        "highlight": "pill",
        "accent": "#FFFFFF",
        "accentText": "#0B4FB3"
      },
      "headline": {
        "en-US": "Drink more **water**"
      },
      "subhead": {
        "en-US": "gentle reminders all day"
      },
      "pop": {
        "rect": [
          0.035,
          0.143,
          0.93,
          0.248
        ],
        "w": 0.84
      },
      "alternatives": {
        "en-US": [
          "Hit your **water goal**",
          "Never forget **to drink**"
        ]
      },
      "hero": {
        "image": "raw/hero-drop.png",
        "layer": "back",
        "x": 0.9,
        "y": 0.56,
        "w": 0.82,
        "h": 0.72,
        "rotate": 6
      },
      "stickers": [
        {
          "icon": "🥤",
          "text": "+330 ml",
          "style": "accent",
          "x": 0.04,
          "y": 0.36,
          "rotate": -7
        },
        {
          "icon": "🔔",
          "text": "Next sip 17:30",
          "style": "dark",
          "pos": "bl",
          "rotate": 5
        },
        {
          "icon": "💦",
          "style": "emoji",
          "x": 0.8,
          "y": 0.66,
          "size": 1.1
        }
      ],
      "options": {
        "deviceScale": 0.66,
        "deviceX": 0.41
      },
      "note": "Hero water drop: AI image generated in Figma (gpt-image-2.5-flare, file \"Appshot hero objects\"), white background removed locally."
    },
    {
      "id": "reminders",
      "layout": "notification-stack",
      "screen": "raw/reminders.png",
      "headline": {
        "en-US": "Never forget to **drink water**"
      },
      "notifications": [
        {
          "title": "Time for a glass 💧",
          "body": "850 ml to go. You're doing great",
          "time": "17:30"
        },
        {
          "title": "Hot day today ☀️",
          "body": "Your goal is 2,500 ml, +200 ml for the heat",
          "time": "08:00"
        }
      ]
    },
    {
      "id": "one-tap",
      "layout": "ui-pieces",
      "screen": "raw/today.png",
      "headline": {
        "en-US": "Log every glass in **one tap**"
      },
      "pieces": [
        {
          "rect": [
            0.035,
            0.39,
            0.93,
            0.123
          ],
          "y": 0.4
        },
        {
          "rect": [
            0.035,
            0.513,
            0.93,
            0.071
          ],
          "y": 0.6,
          "w": 0.78
        }
      ],
      "subhead": {
        "en-US": "200, 330 or 500 ml, or your own size"
      }
    },
    {
      "id": "goal",
      "layout": "floating-cards",
      "screen": "raw/goal.png",
      "headline": {
        "en-US": "A goal **sized for you**"
      },
      "cards": [
        {
          "icon": "☀️",
          "value": "+200 ml",
          "title": "Hot day boost",
          "pos": "tr"
        },
        {
          "icon": "🏃",
          "value": "Moderate",
          "title": "Activity level",
          "pos": "ml"
        }
      ]
    },
    {
      "id": "habit",
      "layout": "hero-device",
      "screen": "raw/history.png",
      "headline": {
        "en-US": "Little sips, **big habit**"
      },
      "subhead": {
        "en-US": "14 days in a row at your goal"
      }
    }
  ]
}
